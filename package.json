{
  "name": "permitmatrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-local API authorization contract tester: generates role/object/property negative cases from a local contract and runs them against a deterministic in-browser mock server.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 6110 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 6110 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-switch": "1.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
